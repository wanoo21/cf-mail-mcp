{
  "name": "mail-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  // Creates the Email Routing rule on deploy (Wrangler 4.113+). Literal addresses only; subdomains have no catch-all.
  // Every MAIL_ADDRESS entry must be listed here.
  "addresses": ["agent@mail.example.com"],
  "vars": {
    // Comma-separated. Default send-from is the first.
    // Every address must also be in `addresses` and send_email.allowed_sender_addresses.
    "MAIL_ADDRESS": "agent@mail.example.com",
    // Comma-separated exact addresses, @domain / *@domain, or * for anyone.
    // If any entry is not an exact address, remove send_email.allowed_destination_addresses.
    "ALLOWED_RECIPIENTS": "you@example.com",
    "RETENTION_DAYS": "90",
    "DAILY_SEND_CAP": "20",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-mcp",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "mail-mcp",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Every MAIL_ADDRESS entry must be listed here.
      "allowed_sender_addresses": ["agent@mail.example.com"],
      // Exact addresses only. Drop this field for * or @domain / *@domain.
      "allowed_destination_addresses": ["you@example.com"],
    },
  ],
}
